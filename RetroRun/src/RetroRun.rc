#include <windows.h>

/* The files are found through the include path, which holds this folder. */
1 ICON "RetroRun.ico"

/* The program's manifest (resource type 24, RT_MANIFEST, ID 1), for MinGW-w64, whose linker makes none. The
   linkers of the MSVC ABI make one and merge this file into it instead (see CMakeLists.txt). */
#ifdef RETRORUN_MANIFEST_RESOURCE
1 24 "RetroRun.manifest"
#endif

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "RetroRun: disk names and icons, autorun.inf programs and AutoPlay"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "RetroRun"
            VALUE "OriginalFilename", "RetroRun.exe"
            VALUE "ProductName", "RetroRun"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
